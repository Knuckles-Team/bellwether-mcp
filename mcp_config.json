{
  "mcpServers": {
    "bellwether-mcp": {
      "command": "uv",
      "args": [
        "run",
        "bellwether-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "condensed",
        "BELLWETHER_CMC_API_KEY": "env://BELLWETHER_CMC_API_KEY",
        "BELLWETHER_FRED_API_KEY": "env://BELLWETHER_FRED_API_KEY"
      }
    }
  }
}
