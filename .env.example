# bellwether-mcp — copy to .env and fill in as needed.
# Every value below is a documented default; the two credential references are
# required for the CoinMarketCap and FRED/ALFRED tools respectively.
# fomc_calendar_list needs neither a credential nor network access.

# Transport / MCP server (see agent_connector_sdk.mcp.parser for the full flag set)
TRANSPORT=stdio
MCP_TOOL_MODE=condensed

# Contact identity advertised in the User-Agent header
BELLWETHER_CONTACT_EMAIL=connectors@knuckles.team

# Credentials — env:// (default) or openbao://apps/bellwether-mcp#<FIELD>
BELLWETHER_CMC_API_KEY=env://BELLWETHER_CMC_API_KEY
BELLWETHER_FRED_API_KEY=env://BELLWETHER_FRED_API_KEY

# Per-source overrides (base URLs, request pacing, page sizes) — see config.py;
# uncomment only to point at a mirror or tune throughput.
# BELLWETHER_CMC_BASE_URL=https://pro-api.coinmarketcap.com
# BELLWETHER_CMC_MIN_INTERVAL=2.0
# BELLWETHER_CMC_PAGE_SIZE=100
# BELLWETHER_FRED_BASE_URL=https://api.stlouisfed.org/fred
# BELLWETHER_FRED_MIN_INTERVAL=0.5
# BELLWETHER_FRED_PAGE_SIZE=1000
# BELLWETHER_FOMC_SOURCE_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm
